# Copy to .env.local to override .env.development / .env.production.
# Leave the Supabase values empty to run Litma in local-only mode (documents saved in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000/litma
NEXT_PUBLIC_BASE_PATH=/litma

# No server secrets go here — the site is static. Writers add their own AI keys in Settings → Your AI keys
# (encrypted by the litma-ai Edge Function). Optional Edge Function secret: LITMA_KEYS_SECRET (encryption key seed).
