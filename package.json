{
  "name": "litma",
  "version": "0.7.13",
  "private": true,
  "description": "Litma · ലിറ്റ്മ — a Malayalam literary writing studio (web, desktop, mobile)",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @litma/web",
    "build": "npm run build -w @litma/web",
    "preview": "npm run preview -w @litma/web",
    "typecheck": "npm run typecheck -w @litma/web && npm run typecheck -w @litma/desktop",
    "sync:shared": "node scripts/sync-shared.mjs",
    "dict": "node scripts/build-dictionary.mjs --out apps/web/public/dict",
    "tokens": "node scripts/export-tokens.mjs",
    "emails": "node scripts/build-email-templates.mjs",
    "desktop": "npm run build:desktop -w @litma/web && npm run start -w @litma/desktop",
    "desktop:dist": "npm run dist -w @litma/desktop",
    "desktop:web": "npm run build:desktop -w @litma/web",
    "release:dry": "node scripts/release.mjs --dry-run",
    "mobile:assets": "node scripts/build-mobile-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
