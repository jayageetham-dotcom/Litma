# Litma — static Next.js export served from public_html/litma
# (deployed by .github/workflows/deploy.yml)

DirectoryIndex index.html
ErrorDocument 404 /litma/404.html
Options -Indexes

<IfModule mod_mime.c>
  AddType image/svg+xml            svg
  AddType application/manifest+json webmanifest
  AddType text/plain               txt
  AddType application/octet-stream dmg exe
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /litma/

  # HTTPS only
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass the Authorization header through to PHP (needed by the MCP relay)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # MCP endpoint: /litma/mcp  →  mcp.php (no directory, so no trailing-slash redirect on POST)
  RewriteRule ^mcp/?$ mcp.php [L,QSA]

  # Pretty URLs without trailing slash → the exported folder (e.g. /litma/desk → /litma/desk/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Next.js puts content-hashed files under _next/static — cache them forever
  <If "%{REQUEST_URI} =~ m#/litma/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # desktop downloads: latest.json changes with every release
  <If "%{REQUEST_URI} =~ m#/litma/downloads/latest\.json$#">
    Header set Cache-Control "no-cache"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve the FTP deploy state file
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
