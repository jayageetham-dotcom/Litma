# Litma: static Next.js export served from the root of https://getlitma.in
# (deployed by .github/workflows/deploy.yml)

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_mime.c>
  AddType image/svg+xml             svg
  AddType image/x-icon              ico
  AddType application/manifest+json webmanifest
  AddType application/xml           xml
  AddType text/plain                txt
  AddType font/woff2                woff2
  AddType application/octet-stream  dmg exe
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address: https://getlitma.in (no www, HTTPS only)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Pass the Authorization header through to PHP (needed by the MCP relay)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # MCP endpoint: /mcp  →  mcp.php (no directory, so no trailing-slash redirect on POST)
  RewriteRule ^mcp/?$ mcp.php [L,QSA]

  # Pretty URLs without trailing slash → the exported folder (e.g. /desk → /desk/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>

<IfModule mod_headers.c>
  # Next.js puts content-hashed files under _next/static: cache them forever
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # fonts, icons and the share picture rarely change
  <If "%{REQUEST_URI} =~ m#^/(fonts|icons|avatars|covers|brands)/|^/(favicon\.ico|apple-touch-icon\.png|og-image\.jpg)$#">
    Header set Cache-Control "public, max-age=604800"
  </If>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # the offline service worker: always check for a newer build
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  # desktop downloads: latest.json changes with every release
  <If "%{REQUEST_URI} =~ m#^/downloads/latest\.json$#">
    Header set Cache-Control "no-cache"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS only from now on (a year; subdomains such as mail. are left out on purpose)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # What pages may load (keep in step with the services the apps use: Supabase, Google sign-in and
  # Drive, Google Fonts, Datamuse, GitHub releases, Cloudflare Turnstile). Next.js's static export
  # needs inline scripts, hence 'unsafe-inline'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.googleapis.com https://accounts.google.com https://api.datamuse.com https://api.github.com https://github.com https://*.githubusercontent.com https://fonts.googleapis.com https://fonts.gstatic.com https://challenges.cloudflare.com; frame-src 'self' https://accounts.google.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  # the human check is also framed by the desktop app (app://litma); nothing else may frame any page
  <If "%{REQUEST_URI} =~ m#^/captcha/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.googleapis.com https://accounts.google.com https://api.datamuse.com https://api.github.com https://github.com https://*.githubusercontent.com https://fonts.googleapis.com https://fonts.gstatic.com https://challenges.cloudflare.com; frame-src 'self' https://accounts.google.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'self' app:"
    Header always unset X-Frame-Options
  </If>
</IfModule>

# Never serve the FTP deploy state file
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
